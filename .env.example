# GEMINI_API_KEY: Required for server-side Gemini AI API calls.
# Never expose this key in client-side code or VITE_ variables.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
APP_URL="MY_APP_URL"

# Optional default Reception WhatsApp number (international format digits only, e.g. 9665XXXXXXXX).
# Leave empty for general mode so users choose the WhatsApp contact themselves.
RECEPTION_WHATSAPP_NUMBER=""
