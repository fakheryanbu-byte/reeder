rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Global safety net: deny all reads and writes by default
    match /{document=**} {
      allow read, write: if false;
    }

    function isSignedIn() {
      return request.auth != null;
    }

    function isVerifiedUser() {
      return isSignedIn() && request.auth.token.email_verified == true;
    }

    function isBootstrappedAdmin() {
      return isVerifiedUser()
        && ('email' in request.auth.token)
        && request.auth.token.email is string
        && request.auth.token.email.lower() == 'fakheryanbu@gmail.com';
    }

    function isAdmin() {
      return isBootstrappedAdmin() || (
        isVerifiedUser()
        && exists(/databases/$(database)/documents/admins/$(request.auth.uid))
      );
    }

    match /hotels/{hotelId} {
      // Single hotel lookup is open for guest QR check-in pages; listing is restricted to owner or admin.
      allow get: if hotelId is string && hotelId.size() >= 2 && hotelId.size() <= 128;
      allow list: if (isSignedIn() && resource.data.ownerUid == request.auth.uid) || isAdmin();

      allow create: if isSignedIn()
        && hotelId is string
        && hotelId.size() >= 2
        && hotelId.size() <= 128
        && request.resource.data.keys().hasAll(['id', 'name', 'ownerUid'])
        && request.resource.data.id == hotelId
        && request.resource.data.ownerUid == request.auth.uid
        && request.resource.data.status == 'pending'
        && request.resource.data.isActive == false;

      allow update: if isSignedIn()
        && request.resource.data.id == resource.data.id
        && request.resource.data.ownerUid == resource.data.ownerUid
        && (
          (resource.data.ownerUid == request.auth.uid
            && request.resource.data.status == resource.data.status
            && request.resource.data.isActive == resource.data.isActive)
          || isAdmin()
        );

      allow delete: if isAdmin();

      match /private/{docId} {
        allow get: if isSignedIn()
          && docId == 'info'
          && (get(/databases/$(database)/documents/hotels/$(hotelId)).data.ownerUid == request.auth.uid || isAdmin());

        allow list: if false;

        allow create: if isSignedIn()
          && docId == 'info'
          && request.resource.data.ownerUid == request.auth.uid;

        allow update: if isSignedIn()
          && docId == 'info'
          && request.resource.data.ownerUid == resource.data.ownerUid
          && (get(/databases/$(database)/documents/hotels/$(hotelId)).data.ownerUid == request.auth.uid || isAdmin());

        allow delete: if isAdmin() && docId == 'info';
      }
    }

    match /checkin_sessions/{sessionId} {
      // Unauthenticated guests can create a session without strict field checks and track their own session by UUID;
      // listing and updates are restricted to signed-in hotel owners/admins; deletion is disabled.
      allow get: if isSignedIn()
        || (sessionId is string && sessionId.size() >= 8 && sessionId.size() <= 128);
      allow list: if isSignedIn()
        && (resource.data.hotelOwnerUid == request.auth.uid || isAdmin());

      allow create: if sessionId is string
        && sessionId.size() >= 2
        && sessionId.size() <= 128
        && request.resource.data.keys().hasAll(['id', 'hotelId', 'status'])
        && request.resource.data.id == sessionId
        && request.resource.data.hotelId is string
        && request.resource.data.hotelId.size() >= 2
        && request.resource.data.status == 'pending';

      allow update: if isSignedIn()
        && (resource.data.hotelOwnerUid == request.auth.uid || isAdmin())
        && request.resource.data.id == resource.data.id
        && request.resource.data.hotelId == resource.data.hotelId;

      allow delete: if false;
    }

    match /admins/{adminUid} {
      allow get: if isBootstrappedAdmin() || (isVerifiedUser() && request.auth.uid == adminUid);
      allow list: if isBootstrappedAdmin();
      allow create: if isBootstrappedAdmin()
        && request.resource.data.keys().hasAll(['uid', 'email', 'addedAt'])
        && request.resource.data.uid == adminUid;
      allow update: if false;
      allow delete: if isBootstrappedAdmin();
    }
  }
}
